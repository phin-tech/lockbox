{
  "version": 1,
  "services": [
    {
      "id": "patchbay",
      "name": "Patchbay",
      "summary": "Your Mac's local Patchbay MCP gateway — gives sandboxes GitHub, AWS, GCP, Cloudflare, Statsig and more without exposing their keys",
      "category": "gateway",
      "host": "host.openshell.internal:7357",
      "variable": "PATCHBAY_TOKEN",
      "auth": "bearer",
      "access": "read-write",
      "keychain_service": "Patchbay",
      "keychain_account": "gateway/token",
      "note": "Reaches Patchbay on this Mac at http://host.openshell.internal:<port>/mcp. Uses Patchbay's gateway token from the Keychain — downstream MCP secrets stay in Patchbay.",
      "tags": ["mcp", "gateway", "local", "aws", "gcp", "github", "cloudflare", "statsig"]
    },
    {
      "id": "github",
      "name": "GitHub",
      "summary": "Repositories, issues, pull requests, releases and GitHub Actions",
      "category": "code",
      "host": "api.github.com",
      "variable": "GITHUB_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://github.com/settings/personal-access-tokens/new",
      "tags": ["git", "prs", "issues", "repos", "gh"]
    },
    {
      "id": "gitlab",
      "name": "GitLab",
      "summary": "Projects, merge requests, issues and CI pipelines",
      "category": "code",
      "host": "gitlab.com",
      "variable": "GITLAB_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://gitlab.com/-/user_settings/personal_access_tokens",
      "tags": ["git", "ci", "mrs", "repos"]
    },
    {
      "id": "linear",
      "name": "Linear",
      "summary": "Issues, projects, cycles and team workflows",
      "category": "code",
      "host": "api.linear.app",
      "variable": "LINEAR_API_KEY",
      "auth": "header",
      "header": "authorization",
      "access": "read-only",
      "help": "https://linear.app/settings/api",
      "tags": ["issues", "tickets", "projects"]
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "summary": "Workers, Pages, R2, D1, KV and DNS via the Cloudflare API",
      "category": "cloud",
      "host": "api.cloudflare.com",
      "variable": "CLOUDFLARE_API_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://dash.cloudflare.com/profile/api-tokens",
      "tags": ["workers", "r2", "d1", "dns", "wrangler", "edge"]
    },
    {
      "id": "gcp",
      "name": "Google Cloud",
      "summary": "BigQuery, Cloud Run, Cloud Logging and Resource Manager REST APIs",
      "category": "cloud",
      "host": "bigquery.googleapis.com",
      "extra_hosts": [
        "run.googleapis.com",
        "logging.googleapis.com",
        "cloudresourcemanager.googleapis.com"
      ],
      "variable": "CLOUDSDK_AUTH_ACCESS_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://console.cloud.google.com/apis/credentials",
      "note": "Accepts an OAuth access token (e.g. from `gcloud auth print-access-token`). For full GCP tooling or long-lived sign-in, connect via Patchbay.",
      "tags": ["gcp", "google", "bigquery", "cloud-run", "logging"]
    },
    {
      "id": "aws-bedrock",
      "name": "AWS Bedrock",
      "summary": "Amazon Bedrock runtime API with a Bedrock bearer API key",
      "category": "cloud",
      "host": "bedrock-runtime.us-east-1.amazonaws.com",
      "variable": "AWS_BEARER_TOKEN_BEDROCK",
      "auth": "bearer",
      "access": "read-write",
      "help": "https://console.aws.amazon.com/bedrock",
      "note": "Change the region in Host if needed. For SigV4 AWS APIs (EKS, CloudWatch, Billing), connect through Patchbay's AWS Labs servers.",
      "tags": ["aws", "amazon", "bedrock", "cloud"]
    },
    {
      "id": "vercel",
      "name": "Vercel",
      "summary": "Deployments, projects, domains and build logs",
      "category": "cloud",
      "host": "api.vercel.com",
      "variable": "VERCEL_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://vercel.com/account/tokens",
      "tags": ["nextjs", "deployments", "hosting"]
    },
    {
      "id": "stripe",
      "name": "Stripe",
      "summary": "Customers, subscriptions, invoices and payments",
      "category": "cloud",
      "host": "api.stripe.com",
      "variable": "STRIPE_SECRET_KEY",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://dashboard.stripe.com/apikeys",
      "tags": ["payments", "billing", "subscriptions"]
    },
    {
      "id": "digitalocean",
      "name": "DigitalOcean",
      "summary": "Droplets, Kubernetes, App Platform and Spaces",
      "category": "cloud",
      "host": "api.digitalocean.com",
      "variable": "DIGITALOCEAN_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://cloud.digitalocean.com/account/api/tokens",
      "tags": ["cloud", "droplets", "infra"]
    },
    {
      "id": "statsig",
      "name": "Statsig",
      "summary": "Feature gates, experiments, dynamic configs and metrics via Console API",
      "category": "observability",
      "host": "statsigapi.net",
      "variable": "STATSIG_CONSOLE_API_KEY",
      "auth": "header",
      "header": "STATSIG-API-KEY",
      "access": "read-only",
      "help": "https://console.statsig.com/",
      "tags": ["feature-flags", "gates", "experiments", "ab-testing"]
    },
    {
      "id": "sentry",
      "name": "Sentry",
      "summary": "Issues, stack traces, events and releases",
      "category": "observability",
      "host": "sentry.io",
      "variable": "SENTRY_AUTH_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://sentry.io/settings/account/api/auth-tokens/",
      "tags": ["errors", "exceptions", "monitoring", "traces"]
    },
    {
      "id": "datadog",
      "name": "Datadog",
      "summary": "Logs, metrics, APM traces and monitors",
      "category": "observability",
      "host": "api.datadoghq.com",
      "variable": "DD_API_KEY",
      "auth": "header",
      "header": "DD-API-KEY",
      "access": "read-only",
      "help": "https://app.datadoghq.com/organization-settings/api-keys",
      "note": "Change Host to your Datadog site (e.g. api.datadoghq.eu or api.us5.datadoghq.com) if not on US1.",
      "tags": ["logs", "metrics", "apm", "monitors"]
    },
    {
      "id": "posthog",
      "name": "PostHog",
      "summary": "Product analytics, feature flags, cohorts and queries",
      "category": "observability",
      "host": "us.posthog.com",
      "variable": "POSTHOG_API_KEY",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://us.posthog.com/settings/user-api-keys",
      "note": "Change Host to eu.posthog.com for EU Cloud.",
      "tags": ["analytics", "feature-flags", "events"]
    },
    {
      "id": "supabase",
      "name": "Supabase",
      "summary": "Projects, branches, migrations and Management API",
      "category": "databases",
      "host": "api.supabase.com",
      "variable": "SUPABASE_ACCESS_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://supabase.com/dashboard/account/tokens",
      "tags": ["postgres", "sql", "baas", "database"]
    },
    {
      "id": "neon",
      "name": "Neon",
      "summary": "Serverless Postgres projects, branches and endpoints",
      "category": "databases",
      "host": "console.neon.tech",
      "variable": "NEON_API_KEY",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://console.neon.tech/app/settings/api-keys",
      "tags": ["postgres", "sql", "database", "branching"]
    },
    {
      "id": "notion",
      "name": "Notion",
      "summary": "Search, read and update Notion pages and databases",
      "category": "productivity",
      "host": "api.notion.com",
      "variable": "NOTION_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://www.notion.so/profile/integrations",
      "tags": ["wiki", "docs", "notes"]
    },
    {
      "id": "figma",
      "name": "Figma",
      "summary": "Inspect designs, components, styles and variables",
      "category": "productivity",
      "host": "api.figma.com",
      "variable": "FIGMA_ACCESS_TOKEN",
      "auth": "header",
      "header": "X-Figma-Token",
      "access": "read-only",
      "help": "https://www.figma.com/developers/api#access-tokens",
      "tags": ["design", "ui", "tokens"]
    },
    {
      "id": "slack",
      "name": "Slack",
      "summary": "Channels, messages and workspace workflows",
      "category": "productivity",
      "host": "slack.com",
      "variable": "SLACK_BOT_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://api.slack.com/apps",
      "tags": ["chat", "messaging", "notifications"]
    },
    {
      "id": "brave-search",
      "name": "Brave Search",
      "summary": "Web and news search via the Brave Search API",
      "category": "productivity",
      "host": "api.search.brave.com",
      "variable": "BRAVE_API_KEY",
      "auth": "header",
      "header": "X-Subscription-Token",
      "access": "read-only",
      "help": "https://api-dashboard.search.brave.com/app/keys",
      "tags": ["search", "web", "docs"]
    },
    {
      "id": "npm",
      "name": "npm",
      "summary": "Private packages and publishing on the npm registry",
      "category": "packages",
      "host": "registry.npmjs.org",
      "variable": "NPM_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://www.npmjs.com/settings/~/tokens",
      "tags": ["node", "javascript", "packages", "registry"]
    },
    {
      "id": "huggingface",
      "name": "Hugging Face",
      "summary": "Models, datasets and spaces on the Hugging Face Hub",
      "category": "packages",
      "host": "huggingface.co",
      "variable": "HF_TOKEN",
      "auth": "bearer",
      "access": "read-only",
      "help": "https://huggingface.co/settings/tokens",
      "tags": ["ml", "models", "datasets", "hub"]
    }
  ]
}
