---
source: crates/core/src/secrets.rs
expression: "format!(\"{:#?}\", wrapped.args)"
---
[
    "run",
    "--",
    "/bin/sh",
    "-c",
    "B=\"$(/usr/bin/security find-generic-password -s \"$1\" -w)\" || exit 1; export B; shift; exec \"$@\"",
    "sh",
    "my service",
    "/opt/homebrew/bin/openshell",
    "sandbox",
    "create",
    "--env-from",
    "A",
    "--env-from",
    "B",
]
